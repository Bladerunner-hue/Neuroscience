            "text/markdown": "<span class=\"markdown prose dark:prose-invert contents\"><h1 id=\"04-feature-engineering-responder-clusters\">04 \u2014 Feature Engineering &amp; Responder Clusters</h1>\n<span class=\"paragraph\"><strong>Chapter 4</strong> \u00b7 Spectral fingerprints + GMM / spectral clustering for music-responder subtypes.</span></span>"
          }
